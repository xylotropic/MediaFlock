MEDIAFLOCK_MODE=live
APP_ORIGIN=https://your-domain.example
DATABASE_URL=postgresql://configured-server-side-database
# Use DB_POOL_MAX=1 for the Vercel web app. Keep the Mac worker pool separate.
DB_POOL_MAX=12
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CSRF_SECRET=minimum-32-random-bytes
POSTFORME_API_KEY=
POSTFORME_CREDENTIAL_MODE=quickstart
POSTFORME_CONNECTION_CALLBACK_CONFIGURED=false
# Use a CA file on the Mac or inline PEM in DATABASE_SSL_CA on Vercel.
# For a multiline dotenv PEM, quote its complete value. Never disable TLS checks.
DATABASE_SSL_CA_FILE=
DATABASE_SSL_CA=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_TOKEN_CEILING=20000
AI_MAX_OUTPUT_TOKENS=1500
MEDIAFLOCK_LIVE_PUBLISHING_ENABLED=false
METRIC_HORIZONS=1,24,72,168

CREDENTIAL_ENCRYPTION_KEY=32-random-bytes-base64-encoded

# Account creation starts closed. Existing owners can still sign in.
MEDIAFLOCK_SELF_SIGNUP_ENABLED=false
# Set true only after custom Supabase Auth SMTP works for non-team addresses.
MEDIAFLOCK_AUTH_EMAIL_ENABLED=false
MEDIAFLOCK_SIGNUP_DAILY_WORKSPACES=25
MEDIAFLOCK_SIGNUP_MAX_WORKSPACES=500

# Vercel build setting: Node 24.x and ENABLE_EXPERIMENTAL_COREPACK=1.
# Leave server-wide provider keys empty for workspaces that supply their own keys.

# Live media runs only in the dedicated local Docker parser; no host fallback.
MEDIAFLOCK_MEDIA_ISOLATION=docker
MEDIAFLOCK_DOCKER_CONTEXT=colima-mediaflock
# Build tools/media-parser/Dockerfile, then pin its installed sha256 image ID.
# Default source tag: mediaflock-media-parser:debian-bookworm-v1-dee25505aaaf
MEDIAFLOCK_MEDIA_IMAGE=
# Shared web/worker capacity. This 750 MiB cap leaves project headroom.
MEDIAFLOCK_STORAGE_TOTAL_BYTES=786432000

# Separate optional account recovery. Keep disabled until the method is selected.
MEDIAFLOCK_RECOVERY_CODES_ENABLED=false
# Stable secret of at least 32 characters when codes are enabled.
# If empty, code hashes use CSRF_SECRET. Never put this in client variables.
MEDIAFLOCK_RECOVERY_PEPPER=
