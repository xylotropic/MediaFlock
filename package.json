{
  "name": "mediaflock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1 --port 3210",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1 --port 3210",
    "worker": "tsx apps/worker/main.ts",
    "worker:once": "tsx apps/worker/main.ts --once",
    "mcp": "tsx apps/mcp/main.ts",
    "setup": "tsx scripts/setup.ts",
    "seed": "MEDIAFLOCK_ENV_FILE=.env.demo tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "tsx tests/browser-journey.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:demo": "MEDIAFLOCK_ENV_FILE=.env.demo next dev apps/web --hostname 127.0.0.1 --port 3211",
    "worker:demo": "MEDIAFLOCK_ENV_FILE=.env.demo tsx apps/worker/main.ts",
    "setup:demo": "tsx scripts/setup.ts",
    "setup:production": "tsx scripts/setup-production.ts",
    "service:install": "tsx scripts/service.ts install",
    "setup:subscriptions": "MEDIAFLOCK_ENV_FILE=.env.live tsx scripts/setup-subscriptions.ts",
    "service:status": "tsx scripts/service.ts status",
    "service:restart": "tsx scripts/service.ts restart",
    "service:stop": "tsx scripts/service.ts stop",
    "service:start": "tsx scripts/service.ts start",
    "api:generate": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@remixicon/react": "4.9.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.117.2",
    "@vercel/functions": "3.9.11",
    "border-beam": "1.4.1",
    "dotenv": "17.4.2",
    "echarts": "6.0.0",
    "geist": "1.7.2",
    "jose": "6.2.12",
    "liquid-gooey": "0.2.2",
    "lucide-react": "0.576.0",
    "metal-fx": "2.0.11",
    "motion": "14.0.0",
    "next": "16.3.8",
    "openai": "7.27.0",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "thinking-orbs": "0.3.2",
    "typegpu": "0.12.6",
    "vgpu": "0.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.12.0",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@webgpu/types": "0.1.74",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
